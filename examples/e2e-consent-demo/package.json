{
  "name": "@helixid/example-e2e-consent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone consent demo: two independent Service Providers issue DelegationGrantCredentials from their own did:web identities, and a Travel Planner agent reuses a standing grant on its second booking with the same SP.",
  "scripts": {
    "setup": "tsx seed/seed.ts",
    "sp:airline": "tsx sp-airline/server.ts",
    "sp:hotel": "tsx sp-hotel/server.ts",
    "agent": "tsx agent/server.ts",
    "test": "vitest run",
    "test:non-live": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/genai": "^2.15.0",
    "@helixid/sdk-js": "github:helixid/helix-sdk-js#d91e2370f6dafcf5306886c2c20b20828acb5d06&path:helix-sdk-js",
    "@helixid/widget": "github:helixid/helix-sdk-js#d91e2370f6dafcf5306886c2c20b20828acb5d06&path:widget",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
