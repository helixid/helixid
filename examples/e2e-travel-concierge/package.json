{
  "name": "@helixid/example-e2e-travel-concierge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastest one-command HelixID demo on KYA-OS: a self-custody LLM agent enrolls, signs each tool call with its own key, and the MCP server runs the tool only after verifying the request proof and the delegation chain in-process.",
  "scripts": {
    "setup": "tsx helixid-setup/seed.ts",
    "mcp": "tsx mcp-server/server.ts",
    "agent": "tsx agent/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@helixid/mcp-middleware": "^1.0.0",
    "@helixid/sdk-js": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "tsx": "^4.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
