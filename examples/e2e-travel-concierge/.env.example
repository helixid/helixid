# Copy to .env and fill in LLM_API_KEY. docker compose reads this file.

# ── LLM (the agent's brain) ──────────────────────────────────────────────────
# Which provider the agent uses to decide when to call the booking tool.
# One of: anthropic (default) | openai | azure | gemini
LLM_PROVIDER=anthropic
# Your real provider key. Required — the agent is a real LLM agent.
#   anthropic → an Anthropic API key
#   openai    → an OpenAI API key
#   azure     → your Azure OpenAI resource key (+ the AZURE_* vars below)
#   gemini    → a Google AI Studio API key
LLM_API_KEY=
# Optional model override. Currently only read by the Gemini provider
# (defaults to gemini-flash-latest); the other providers use a fixed model.
LLM_MODEL=

# Only needed when LLM_PROVIDER=azure (Azure OpenAI). Put values on their own
# lines — do NOT append trailing "# comments" after a value.
# Endpoint, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Your chat model deployment name (used as the model), e.g. gpt-4o
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── HelixID (safe demo defaults; override only if you want to) ───────────────
# Admin key used by the seeder and agent (enrollment tokens, signing VPs for
# server-held agent keys, delegation, revocation), by the MCP server (enrolling
# the two demo services, signing their consent grants), and by Console to read
# the audit log. Must be at least 16 characters.
HELIX_ADMIN_API_KEY=dev-admin-key-change-in-production

# NOTE: No Hedera credentials are required. This demo enrolls the agent with a
# local did:key wallet via the single-roundtrip /v1/enroll flow, and the issuer
# runs in did:key mode — the whole trust flow is real and fully local.
