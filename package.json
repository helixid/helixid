{
  "name": "@helixid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test:deps": "true",
    "test:all": "pnpm run test:deps && vitest run --passWithNoTests",
    "test:non-live": "pnpm run test:deps && vitest run --exclude 'tests/live/**' --passWithNoTests",
    "test:live": "pnpm run test:deps && vitest run tests/live --reporter=verbose --reporter=github-actions",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:prepare": "node scripts/prepare-test-db.mjs",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "test:e2e": "pnpm --filter @helixid/e2e run test",
    "workspace:build": "pnpm run build && pnpm -r --if-present run build",
    "workspace:typecheck": "pnpm run typecheck && pnpm --filter '!@helixid/example-e2e-consent-demo' -r --if-present run typecheck",
    "workspace:test:non-live": "pnpm run test:non-live && pnpm --filter '!@helixid/example-e2e-consent-demo' -r --if-present run test:non-live",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .gitignore",
    "setup": "tsx scripts/setup.ts",
    "setup:hedera": "tsx scripts/setup-hedera.ts",
    "example:verify-vp": "tsx examples/verify-vp.ts",
    "example:verify-vp:sdk": "tsx examples/verify-vp-sdk.ts",
    "example:verify-vp:session-bridge": "tsx examples/verify-vp-session-bridge.ts",
    "example:scope-check": "tsx examples/scope-check.ts",
    "example:self-verify": "tsx examples/self-verify.ts",
    "example:revocation-check": "tsx examples/revocation-check.ts",
    "example:verifier:vp-cache": "tsx examples/verifier-vp-cache-cycle.ts",
    "example:middleware:setup": "pnpm --filter @helixid/example-framework-middleware run setup",
    "example:middleware:langchain": "pnpm --filter @helixid/example-framework-middleware run langchain",
    "example:middleware:mcp": "pnpm --filter @helixid/example-framework-middleware run mcp"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@helixid/core": "^2.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "protobufjs": "8.0.2"
    }
  },
  "devDependencies": {
    "@helixid/did-hedera": "^0.1.2",
    "@helixid/sdk-js": "^0.4.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
