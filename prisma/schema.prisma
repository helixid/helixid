// Vendored verbatim from @helixid/core's prisma/schema.prisma. Prisma has
// no cross-package schema composition today, so this file has to be
// physically copied rather than imported — re-copy it whenever the pinned
// @helixid/core version bumps; never hand-edit a model here, any change
// belongs upstream in helix-core, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Did {
  id                   String      @id
  subjectType          String
  controller           String
  publicKey            String
  publicKeyMultibase   String?
  hederaTopicId        String      @default("")
  hederaSequenceNumber Int         @default(0)
  hederaTransactionId  String
  didDocument          Json
  deactivatedAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  updates              DidUpdate[]
  vcs                  Vc[]

  @@index([id])
  @@index([publicKey])
  @@map("dids")
}

model DidUpdate {
  id                  String   @id @default(cuid())
  didId               String
  updateType          String
  hederaTransactionId String
  payload             Json
  createdAt           DateTime @default(now())
  did                 Did      @relation(fields: [didId], references: [id])

  @@map("did_updates")
}

model Vc {
  id               String    @id @default(cuid())
  vcId             String    @unique
  subjectDid       String
  subjectType      String
  vcJson           Json
  privilegeScopes  Json?
  statusListIndex  Int
  expiresAt        DateTime?
  revokedAt        DateTime?
  renewedByVcId    String?
  delegatedFrom    String?
  delegationDepth  Int?
  maxDelegationDepth Int?
  parentVcId       String?
  // Lookup columns, denormalised from vcJson so a credential can be found
  // without reading every row's JSON: the credential's own type (the entry
  // of `type` that is not VerifiableCredential), who signed it, the user it
  // was granted on behalf of (DelegationGrantCredential only) and the
  // canonical scope set (sorted, space-joined). A consent grant is one of
  // (userDid, subjectDid, issuerDid, scopeKey): same four, same grant.
  vcType           String?
  issuerDid        String?
  userDid          String?
  scopeKey         String?
  createdAt        DateTime  @default(now())
  did              Did       @relation(fields: [subjectDid], references: [id])

  @@index([subjectDid])
  @@index([vcId])
  @@index([parentVcId])
  @@index([subjectDid, vcType, issuerDid, userDid])
  @@map("vcs")
}

model StatusListEntry {
  id          String   @id @default(cuid())
  listId      String   @unique
  encodedList String
  nextIndex   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("status_list_entries")
}

// Custody-held private keys for every kind of DID the platform signs for
// (agent, service, issuer, user). Nobody holds their own key.
model DidKey {
  id                  String   @id @default(cuid())
  did                 String   @unique
  subjectType         String   @default("agent")
  encryptedPrivateKey String
  iv                  String
  authTag             String
  algorithm           String
  createdAt           DateTime @default(now())

  @@map("did_keys")
}

model EnrollmentToken {
  id               String      @id @default(cuid())
  tokenHash        String      @unique
  agentName        String
  requestedScopes  String
  requestedDomains String
  maxDelegationDepth Int         @default(0)
  expiresAt        DateTime?
  usedAt           DateTime?
  createdAt        DateTime    @default(now())
  challenges       Challenge[]

  @@map("enrollment_tokens")
}

model Challenge {
  id                  String           @id @default(cuid())
  challengeId         String           @unique
  nonce               String
  did                 String
  purpose             String
  pendingPublicKeyHex String?
  pendingDomains      String?
  pendingDidCreateStateJson String?
  pendingDidCreatePayloadHex String?
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime         @default(now())
  enrollmentToken     EnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id])
  enrollmentTokenId   String?

  @@map("challenges")
}

// Enrolled Service Providers: the identity side (the DID) of a service. Its
// private key is in did_keys (subjectType 'service'); the VP-target lookup
// by name stays in service_registry. A hosted build attributes rows to
// accounts with its own link table rather than a column here.
model Service {
  id            String    @id
  did           String    @unique
  name          String
  domain        String
  requiredScope String
  description   String?
  // Free-form label ('express', 'flask', ...): recorded as given, never
  // used to select behaviour.
  framework     String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([name])
  @@map("services")
}

// Onboarded agents as records: the name an agent was onboarded with, its
// owner-controlled visibility, and what is known about its own onboarding
// credential (kept here so a registry can filter and page on status without
// reading `vcs`). Keyed by the agent DID. A hosted build attributes rows to
// accounts with its own link table rather than a column here, as for services.
model Agent {
  did                 String    @id
  name                String?
  // 'private' | 'public'. Nothing becomes public by default or by migration.
  visibility          String    @default("private")
  visibilityChangedAt DateTime?
  publishedAt         DateTime?
  credentialVcId      String?
  credentialExpiresAt DateTime?
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([visibility, publishedAt])
  @@index([credentialVcId])
  @@map("agents")
}

/// KYA-OS audit ledgers (story A-2, AAP-2 Chained): one per tenant.
/// `tenantKey` is the RFC 8785 text of `tenantRef`. Never deleted (trigger).
model AuditLedger {
  ledgerId      String   @id
  tenantKey     String   @unique
  tenantRef     Json
  activeEpochId String?
  createdAt     DateTime @default(now())

  @@map("audit_ledgers")
}

/// The ledger-head row: one per epoch, its committed head, its one recorder
/// authority and, once closed, its seal. Triggers let a head only advance by
/// one onto a stored entry or be sealed once; never deleted.
model AuditLedgerHead {
  ledgerId         String
  ledgerEpochId    String
  position         BigInt    @unique @default(autoincrement())
  sequence         BigInt
  entryDigest      String
  recorderDid      String
  recorderKid      String
  recorderAlg      String
  status           String    @default("active")
  terminalDigest   String?
  sealReason       String?
  successorEpochId String?
  sealedAt         DateTime?
  openedAt         DateTime  @default(now())

  @@id([ledgerId, ledgerEpochId])
  @@map("audit_ledger_heads")
}

/// The atomic journal. Append-only: no update or delete path in code, and
/// triggers refuse UPDATE, DELETE, TRUNCATE and any insert that is not the
/// next entry of an active epoch. `entry` is the RFC 8785 text of the signed
/// entry; the other columns index it. Retained indefinitely.
model AuditJournalEntry {
  id                  BigInt   @id @default(autoincrement())
  ledgerId            String
  ledgerEpochId       String
  sequence            BigInt
  idempotencyKey      String
  eventId             String
  sourceId            String
  eventType           String
  family              String
  eventDigest         String
  entryDigest         String
  previousEntryDigest String?
  recordedAt          BigInt
  correlationId       String?
  entry               String
  insertedAt          DateTime @default(now())

  @@unique([ledgerId, ledgerEpochId, sequence])
  @@unique([ledgerId, idempotencyKey])
  @@index([eventType, recordedAt])
  @@index([family, recordedAt])
  @@index([correlationId])
  @@index([recordedAt])
  @@map("audit_journal_entries")
}

/// Legal holds: applied once, released once, never deleted (trigger).
model AuditLegalHold {
  holdId     String    @id
  ledgerId   String
  targetKind String
  objectId   String?
  target     Json
  appliedAt  DateTime
  appliedBy  String
  releasedAt DateTime?
  releasedBy String?

  @@index([ledgerId])
  @@index([objectId])
  @@map("audit_legal_holds")
}

/// The evidence vault: AES-256-GCM objects an event refers to by `EvidenceRef`.
/// The ciphertext is opaque without the key and the tenant-bound AAD. Disposal
/// (A-2) clears the ciphertext and keeps the reference; nothing else changes.
model AuditEvidence {
  objectId         String    @id
  ciphertextDigest String
  size             BigInt
  mediaType        String
  keyId            String
  ref              Json
  ciphertext       Bytes?
  storedAt         DateTime  @default(now())
  disposedAt       DateTime?
  disposalReason   String?

  @@map("audit_evidence")
}
