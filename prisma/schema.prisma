// Vendored verbatim from @helixid/core's prisma/schema.prisma. Prisma has
// no cross-package schema composition today, so this file has to be
// physically copied rather than imported — re-copy it whenever the pinned
// @helixid/core version bumps; never hand-edit a model here, any change
// belongs upstream in helix-core, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Did {
  id                   String      @id
  subjectType          String
  controller           String
  publicKey            String
  publicKeyMultibase   String?
  hederaTopicId        String      @default("")
  hederaSequenceNumber Int         @default(0)
  hederaTransactionId  String
  didDocument          Json
  deactivatedAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  updates              DidUpdate[]
  vcs                  Vc[]

  @@index([id])
  @@index([publicKey])
  @@map("dids")
}

model DidUpdate {
  id                  String   @id @default(cuid())
  didId               String
  updateType          String
  hederaTransactionId String
  payload             Json
  createdAt           DateTime @default(now())
  did                 Did      @relation(fields: [didId], references: [id])

  @@map("did_updates")
}

model Vc {
  id               String    @id @default(cuid())
  vcId             String    @unique
  subjectDid       String
  subjectType      String
  vcJson           Json
  privilegeScopes  Json?
  statusListIndex  Int
  expiresAt        DateTime
  revokedAt        DateTime?
  renewedByVcId    String?
  delegatedFrom    String?
  delegationDepth  Int?
  maxDelegationDepth Int?
  parentVcId       String?
  createdAt        DateTime  @default(now())
  did              Did       @relation(fields: [subjectDid], references: [id])

  @@index([subjectDid])
  @@index([vcId])
  @@index([parentVcId])
  @@map("vcs")
}

model StatusListEntry {
  id          String   @id @default(cuid())
  listId      String   @unique
  encodedList String
  nextIndex   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("status_list_entries")
}

model VpId {
  id            String   @id @default(cuid())
  vpId          String   @unique
  agentDid      String
  userDid       String
  targetService String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([vpId])
  @@map("vp_ids")
}

/// Server-held agent private keys. Agent self-custody is retired: the server
/// generates the keypair at onboarding and stores the private key encrypted
/// here, so this table is what makes POST /v1/onboard and the custodial
/// signing routes work at all.
///
/// Mirrors @helixid/core's own AgentKey model — core owns the services that
/// read and write it (AgentKeyRepository / AesGcmKeyCustody), and this schema
/// has to declare the same table for the Postgres adapter, which builds its
/// schema from these migrations rather than from core's.
model AgentKey {
  id                  String   @id @default(cuid())
  did                 String   @unique
  encryptedPrivateKey String
  iv                  String
  authTag             String
  algorithm           String
  createdAt           DateTime @default(now())

  @@map("agent_keys")
}

model EnrollmentToken {
  id               String      @id @default(cuid())
  tokenHash        String      @unique
  agentName        String
  requestedScopes  String
  requestedDomains String
  maxDelegationDepth Int         @default(0)
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime    @default(now())
  challenges       Challenge[]

  @@map("enrollment_tokens")
}

model Challenge {
  id                  String           @id @default(cuid())
  challengeId         String           @unique
  nonce               String
  did                 String
  purpose             String
  pendingPublicKeyHex String?
  pendingDomains      String?
  pendingDidCreateStateJson String?
  pendingDidCreatePayloadHex String?
  expiresAt           DateTime
  verifiedAt          DateTime?
  createdAt           DateTime         @default(now())
  enrollmentToken     EnrollmentToken? @relation(fields: [enrollmentTokenId], references: [id])
  enrollmentTokenId   String?

  @@map("challenges")
}

model PreparedPayload {
  id                String    @id @default(cuid())
  token             String    @unique
  // 'delegation' | 'grant' — see docs/proposal-sdk-api-only.md. One purpose
  // per row; the finalize endpoint for a given purpose rejects tokens
  // prepared for a different one (PreparedPayloadPurposeMismatchError).
  purpose           String
  // Canonical JSON of the unsigned VC skeleton (no `proof` field). This is
  // exactly what hashCanonicalPayload() was run over to produce canonicalHash.
  unsignedPayload    String
  canonicalHash      String
  // DID whose signature finalize() must accept over canonicalHash. Prevents
  // a captured prepare response from being finalized with a different key.
  expectedSignerDid  String
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@map("prepared_payloads")
}

model ServiceRegistry {
  id                 String   @id @default(cuid())
  serviceName        String   @unique
  displayName        String
  verifiedDomain     String
  publicKeyMultibase String
  apiEndpoint        String
  metadata           String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("service_registry")
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  eventType   String
  requestId   String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([requestId])
  @@map("audit_log")
}
